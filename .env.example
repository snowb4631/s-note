# 이름만 적는다. 값은 저장소에 넣지 않는다. 자세한 설명은 README.md 참고.
# 운영(NODE_ENV=production)에서 아래 값이 없으면 /api/send, /api/pdf는 503으로 거절한다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
MAIL_FROM=
# true일 때만 이메일 받기를 연다. 그 외에는 화면에 미구현으로 표시한다.
EMAIL_SENDING_ENABLED=
# 선택. 하루 전체 발송 상한. 비우면 80.
SEND_DAILY_CAP=

# 광고(선택). 둘 다 있어야 /send에 슬롯과 스크립트가 렌더된다.
ADSENSE_CLIENT=
ADSENSE_SLOT=
